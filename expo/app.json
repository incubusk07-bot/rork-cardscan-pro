{
  "expo": {
    "name": "Verex",
    "slug": "q882yueprh71emx9dhkpa",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": ["verex", "com.cardscanner.app"],
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.rork.q882yueprh71emx9dhkpa"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.cardscanner.app"
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://rork.com/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "Verex uses the camera to scan trading cards for authenticity signals and condition pre-grading."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Verex needs photo access so you can pre-grade cards from existing photos."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}